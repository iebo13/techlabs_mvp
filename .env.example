# Optional: Unsplash Access Key for local scripts that call api.unsplash.com (never commit real keys).
# Register at https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=

# Sanity CMS
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2026-04-11

# Data source: 'mock' or 'sanity'
VITE_DATA_SOURCE=mock

# Firebase (web app config — Project Settings → General → Your apps)
# Analytics requires VITE_FIREBASE_MEASUREMENT_ID (G-XXXXXXX). Without it, no events are sent.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Set to 'true' to enable Firebase Analytics in development (always on in production builds)
VITE_ENABLE_ANALYTICS=
